{
  "name": "agent-office",
  "version": "0.1.0",
  "description": "A local, read-only Codex office for macOS, with no extra model calls.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build --bundles app -- --locked",
    "release:check": "node scripts/check-release.mjs",
    "release:package": "node scripts/package-release.mjs",
    "release:build": "npm run release:check && npm run desktop:build && npm run release:package",
    "art:render": "node scripts/render-office.mjs",
    "test": "node scripts/desktop.mjs test",
    "test:ui": "playwright test",
    "test:replay": "node scripts/replay.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "three": "^0.186.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
